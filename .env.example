# Prender para que el frontend hable con el backend real (OwnSpaceAPI)
# en vez de la capa de mocks. Copiar a .env.local (gitignorado) y
# ajustar si hace falta — NEXT_PUBLIC_API_URL tiene un default sensato
# (perfil HTTPS local de OwnSpaceAPI) si no se define. Requiere confiar
# una vez en el certificado de desarrollo: `dotnet dev-certs https --trust`
# (si no, el navegador rechaza la cookie de sesión por el flag Secure).
NEXT_PUBLIC_USE_REAL_API=true
NEXT_PUBLIC_API_URL=https://localhost:7127/api/v1